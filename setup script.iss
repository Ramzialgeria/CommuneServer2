[Code]

var
  PgBinDir: string;

function FindPostgresBin(): string;
var
  V: Integer;
  P: string;
begin
  Result := '';

  { Check common PostgreSQL installation directories }
  for V := 18 downto 13 do
  begin
    P := ExpandConstant('{pf}') + '\PostgreSQL\' +
      IntToStr(V) + '\bin\psql.exe';

    if FileExists(P) then
    begin
      Result := ExtractFileDir(P);
      Exit;
    end;
  end;
end;

function RunAndCheck(
  const Filename, Params: string;
  const Description: string): Boolean;
var
  ExitCode: Integer;
begin
  Result := Exec(
    Filename,
    Params,
    '',
    SW_SHOW,
    ewWaitUntilTerminated,
    ExitCode
  ) and (ExitCode = 0);

  if not Result then
    MsgBox(
      Description + ' failed. Exit code: ' +
      IntToStr(ExitCode),
      mbError,
      MB_OK
    );
end;

function InitializeSetup(): Boolean;
begin
  Result := True;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  InstallerPath: string;
  PsqlPath: string;
  ExitCode: Integer;
  ResultCode: Integer;
  Params: string;
begin
  if CurStep <> ssPostInstall then
    Exit;

  PgBinDir := FindPostgresBin();

  { Install PostgreSQL if not found }
  if PgBinDir = '' then
  begin
    InstallerPath := ExpandConstant(
      '{tmp}\{#PgInstaller}'
    );

    if not FileExists(InstallerPath) then
    begin
      MsgBox(
        'PostgreSQL installer was not found: ' +
        InstallerPath,
        mbError,
        MB_OK
      );
      Abort;
    end;

    Params :=
      '--mode unattended ' +
      '--unattendedmodeui minimal ' +
      '--superaccount postgres ' +
      '--superpassword "{#PgPassword}" ' +
      '--serverport 5432 ' +
      '--prefix "' + ExpandConstant('{pf}') +
      '\PostgreSQL\{#PgVersion}"';

      WizardForm.StatusLabel.Caption :=
      'Installation de PostgreSQL 17.4...';
      WizardForm.Update;

    if not RunAndCheck(
      InstallerPath,
      Params,
      'PostgreSQL installation'
    ) then
      Abort;
        
      

    PgBinDir := FindPostgresBin();
  end;

  if PgBinDir = '' then
  begin
    MsgBox(
      'Could not locate PostgreSQL psql.exe.',
      mbError,
      MB_OK
    );
    Abort;
  end;

  PsqlPath := PgBinDir + '\psql.exe';

  { Create the empty database if it does not exist.
    This example assumes the PostgreSQL password above
    was used for the installation. }

  Params :=
    '-h 127.0.0.1 -p 5432 -U postgres ' +
    '-d postgres -w -tAc ' +
    '"SELECT 1 FROM pg_database ' +
    'WHERE datname = ''CommuneServer''"';

  { Supply PGPASSWORD through a temporary process wrapper
    in production, or configure authentication securely.
    Do not put a production database password in source. }

  if not Exec(
    ExpandConstant('{cmd}'),
    '/C set "PGPASSWORD={#PgPassword}" && "' +
    PsqlPath + '" ' + Params,
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ExitCode
  ) then
  begin
    MsgBox(
      'Could not execute psql.exe.',
      mbError,
      MB_OK
    );
    Abort;
  end;

  if ExitCode <> 0 then
  begin
    MsgBox(
      'Could not connect to PostgreSQL. Check the ' +
      'service, port, and database credentials.',
      mbError,
      MB_OK
    );
    Abort;
  end;

  { Create database only when it does not exist }
  if not Exec(
    ExpandConstant('{cmd}'),
    '/C set "PGPASSWORD={#PgPassword}" && "' +
    PsqlPath + '" -h 127.0.0.1 -p 5432 ' +
    '-U postgres -d postgres -w -c ' +
    '"CREATE DATABASE ""CommuneServer"";"',
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode
  ) then
  begin
    MsgBox(
      'Could not execute the database creation command.',
      mbError,
      MB_OK
    );
    Abort;
  end;

  { CREATE DATABASE fails if the database already exists.
    Treat that case as an existing installation. }
  if ResultCode <> 0 then
  begin
    if Exec(
      ExpandConstant('{cmd}'),
      '/C set "PGPASSWORD={#PgPassword}" && "' +
      PsqlPath + '" -h 127.0.0.1 -p 5432 ' +
      '-U postgres -d postgres -w -tAc ' +
      '"SELECT 1 FROM pg_database ' +
      'WHERE datname = ''CommuneServer''"',
      '',
      SW_HIDE,
      ewWaitUntilTerminated,
      ExitCode
    ) and (ExitCode = 0) then
    begin
      { Database may already exist; leave it untouched. }
    end
    else
    begin
      MsgBox(
        'Failed to create CommuneServer database.',
        mbError,
        MB_OK
      );
      Abort;
    end;
  end;

    { Import the schema only when this installer created the database.
    ResultCode = 0 means CREATE DATABASE succeeded. }

  { Import the schema only when this installer created the database. }

if ResultCode = 0 then
begin
  WizardForm.StatusLabel.Caption :=
    'Initialisation de la base de données...';
  WizardForm.Update;

  if not Exec(
    ExpandConstant('{cmd}'),
    '/C set "PGPASSWORD={#PgPassword}" && "' +
    PsqlPath + '" ' +
    '-h 127.0.0.1 ' +
    '-p 5432 ' +
    '-U postgres ' +
    '-d "CommuneServer" ' +
    '-w ' +
    '-v ON_ERROR_STOP=1 ' +
    '-f "' + ExpandConstant('{app}\Database\CommuneServer.sql') + '"',
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ExitCode
  ) then
  begin
    MsgBox(
      'Could not execute the database schema file.',
      mbError,
      MB_OK
    );
    Abort;
  end;

    if ExitCode <> 0 then
    begin
      MsgBox(
        'Failed to initialize the CommuneServer database.' +
        Chr(13) + Chr(10) +
        'Check CommuneServer.sql and the PostgreSQL logs.',
        mbError,
        MB_OK
      );
      Abort;
    end;
  end;

  MsgBox(
    'CommuneServer installation completed.' +
    Chr(13) + Chr(10) +
    'Database: CommuneServer',
    mbInformation,
    MB_OK
  );
end;

function IsDotNet472OrLaterInstalled(): Boolean;
var
  release: Cardinal;
begin
  Result :=
    RegQueryDWordValue(HKLM,
      'SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full',
      'Release',
      release)
    and (release >= 461808);  // 4.7.2 minimum release key
end;